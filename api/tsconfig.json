{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": ".",
    "baseUrl": ".",
    "paths": {
      "@domain/*": ["./domain/*"],
      "@handlers/*": ["./src/handlers/*"],
      "@services/*": ["./src/services/*"],
      "@repositories/*": ["./src/repositories/*"],
      "@middleware/*": ["./src/middleware/*"],
      "@config/*": ["./src/config/*"]
    }
  },
  "include": ["src/**/*", "domain/**/*"],
  "exclude": ["node_modules", "dist"]
}
